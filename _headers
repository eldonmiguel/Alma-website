# Pages: always check for a new version, but let the back button reuse the page.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/es/
  Cache-Control: public, max-age=0, must-revalidate

# Code and styles have a fingerprint in the file name, so they can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts rarely change.
/fonts/*
  Cache-Control: public, max-age=2592000

# Photos and videos: keep for a week. Use a new file name (or ?v=) when replacing one.
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
